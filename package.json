{
  "name": "atomic-ash",
  "private": true,
  "version": "0.1.0",
  "description": "Atomic Ash — survivor-like retrofuturista. com.vaultstudio.atomicash",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
